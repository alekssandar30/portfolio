---
import { industries } from "@/data/industries";
---

<ol class="experience-list">
  {
    industries.map((industry, index) => (
      <li>
        <span class="industry-index">{String(index + 1).padStart(2, "0")}</span>
        <h3>{industry.name}</h3>
        <p>{industry.projects.join(" · ")}</p>
      </li>
    ))
  }
</ol>

<style>
  .experience-list {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem 1rem;
    align-items: baseline;
  }

  .industry-index,
  li p {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.3;
  }

  li p {
    grid-column: 2;
    line-height: 1.6;
  }

  @media (min-width: 48rem) {
    li {
      grid-template-columns: 3rem minmax(16rem, 0.9fr) minmax(12rem, 1.1fr);
      gap: 2rem;
    }

    h3 {
      font-size: 1.5rem;
    }

    li p {
      grid-column: auto;
      font-size: 0.875rem;
    }
  }
</style>
