---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  class?: string;
}

const { eyebrow, title, text, class: className } = Astro.props;
---

<header class:list={["section-intro", className]}>
  <p class="annotation">{eyebrow}</p>
  <h2 class="display-heading">{title}</h2>
  {text && <p class="section-description">{text}</p>}
</header>

<style>
  .section-intro {
    margin-bottom: 3rem;
  }

  h2 {
    max-width: 22ch;
    margin-top: 1.5rem;
    font-size: clamp(1.75rem, 4.2vw, 3rem);
  }

  .section-description {
    max-width: 58ch;
    margin-top: 1.25rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  @media (min-width: 48rem) {
    .section-intro {
      margin-bottom: 4rem;
    }
  }
</style>
