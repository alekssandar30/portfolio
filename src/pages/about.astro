---
import { person } from "@/data/person";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { personSchema, professionalServiceSchema } from "@/lib/schema";
import { siteConfig } from "@/lib/site";

const siteUrl = Astro.site?.toString() ?? siteConfig.url;
---

<BaseLayout
  title="About"
  description="About Aleksandar Novakovic, full-stack software engineer."
  pathname="/about"
  jsonLd={[personSchema(siteUrl), professionalServiceSchema(siteUrl)]}
>
  <section class="page-section">
    <div class="container-shell">
      <header class="page-head">
        <div class="head-rule">
          <p class="annotation">About</p>
          <p class="annotation head-meta">Novi Sad · 45.2671° N, 19.8335° E</p>
        </div>
        <h1 class="display-heading">
          Software engineering for production systems.
        </h1>
      </header>

      <div class="profile-layout">
        <aside class="profile-aside">
          <figure>
            <img
              src="/aleksandar-novakovic.png"
              alt="Aleksandar Novakovic"
              width="256"
              height="256"
            />
            <figcaption class="trace-annotation">
              {person.name} - {person.location}
            </figcaption>
          </figure>

          <dl class="profile-facts">
            <div>
              <dt class="trace-annotation">Engagement</dt>
              <dd>Independent B2B contractor through my agency {person.company}</dd>
            </div>
            <div>
              <dt class="trace-annotation">Education</dt>
              <dd>{person.education.institution}</dd>
              <dd>{person.education.focus}</dd>
            </div>
            <div>
              <dt class="trace-annotation">Languages</dt>
              {
                person.languages.map((language) => (
                  <dd>
                    {language.name} · {language.level}
                  </dd>
                ))
              }
            </div>
          </dl>
        </aside>

        <div class="profile-copy">
          <p>
            I am Aleksandar Novakovic, a full-stack software engineer from Novi
            Sad, Serbia, working independently through my agency mBIT Solutions.
          </p>
          <p>
            Over the past seven-plus years I have worked on production software
            across frontend and backend systems, primarily using TypeScript,
            C#/.NET, Angular, React and Node.js.
          </p>
          <p>
            My experience spans enterprise applications, financial systems,
            banking, industrial and construction software, e-health platforms
            and startup products.
          </p>
          <p>
            I usually work inside existing engineering teams where the challenge
            is understanding an established system, navigating its constraints,
            improving architecture where it matters and delivering features
            without destabilizing production.
          </p>
          <p class="kw-group">
            My workflow has increasingly become
            <span class="kw-scan">AI-native</span>. I use coding agents for
            codebase exploration, implementation planning, research,
            refactoring and development while keeping architecture,
            verification and engineering decisions under explicit control.
          </p>
          <p>
            I care less about particular frameworks than about building software
            that remains understandable, maintainable and useful after it
            reaches production.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    padding-block: 4rem 7rem;
  }

  .page-head {
    margin-bottom: 3rem;
  }

  .head-rule {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .head-meta {
    color: var(--faint);
  }

  h1 {
    max-width: 18ch;
    margin-top: 1.5rem;
    font-size: clamp(2rem, 5.4vw, 3.75rem);
  }

  .profile-layout {
    display: grid;
    gap: 3rem;
  }

  .profile-aside figure {
    max-width: 12rem;
    margin: 0;
  }

  /* the source portrait is a circular crop - frame it as one */
  .profile-aside img {
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }

  .profile-aside figcaption {
    margin-top: 0.75rem;
  }

  .profile-facts {
    display: grid;
    gap: 1.75rem;
    margin: 2.5rem 0 0;
  }

  .profile-facts dd {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .profile-facts dd + dd {
    margin-top: 0.25rem;
  }

  .profile-copy {
    max-width: 44rem;
  }

  .profile-copy > p {
    margin-top: 1.5rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .profile-copy > p:first-child {
    margin-top: 0;
    color: var(--ink);
    font-size: 1.25rem;
    line-height: 1.45;
  }

  @media (min-width: 48rem) {
    .page-section {
      padding-block: 6rem 10rem;
    }

    .page-head {
      margin-bottom: 4.5rem;
    }

    .profile-layout {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 6rem;
    }
  }
</style>
