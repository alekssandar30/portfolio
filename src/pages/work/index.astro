---
import ProjectRow from "@/components/ProjectRow.astro";
import { projectIndex } from "@/data/projects";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.visibility !== "unknown")
  .sort((a, b) => projectIndex(a.slug) - projectIndex(b.slug));
---

<BaseLayout
  title="Work"
  description="Selected software engineering work across industrial software, procurement technology, banking, healthcare and startup products."
>
  <section class="page-section">
    <div class="container-shell">
      <header class="page-head">
        <p class="annotation">Work</p>
        <h1 class="display-heading">Selected systems and product work.</h1>
        <p class="page-lede">
          Production engineering across industrial software, procurement
          technology, banking, healthcare and startup environments.
        </p>
      </header>
      <div class="project-index">
        {
          projects.map((project) => (
            <ProjectRow project={project} class="reveal" />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    padding-block: 4rem 7rem;
  }

  .page-head {
    margin-bottom: 3rem;
  }

  h1 {
    max-width: 18ch;
    margin-top: 1.5rem;
    font-size: clamp(2.25rem, 6vw, 4.5rem);
  }

  .page-lede {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  @media (min-width: 48rem) {
    .page-section {
      padding-block: 6rem 10rem;
    }

    .page-head {
      margin-bottom: 4.5rem;
    }
  }
</style>
