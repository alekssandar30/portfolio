---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).filter(
    (project) => project.data.visibility !== "unknown",
  );
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await project.render();
const timeline = project.data.startYear
  ? project.data.endYear
    ? `${project.data.startYear} - ${project.data.endYear}`
    : `Since ${project.data.startYear}`
  : undefined;
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  pathname={`/work/${project.slug}`}
>
  <article class="project-page">
    <div class="container-shell">
      <a class="back-link" href="/work">← Index</a>

      <header class="project-header">
        <p class="annotation">{project.data.industry}</p>
        <h1
          class="display-heading"
          transition:name={`project-title-${project.slug}`}
        >
          {project.data.title}
        </h1>
        {
          project.data.subtitle && (
            <p class="project-subtitle">{project.data.subtitle}</p>
          )
        }
        <p class="project-summary">{project.data.summary}</p>
      </header>

      <dl class="meta-band">
        {
          project.data.role && (
            <div>
              <dt class="trace-annotation">Role</dt>
              <dd>{project.data.role}</dd>
            </div>
          )
        }
        {
          project.data.client && (
            <div>
              <dt class="trace-annotation">Client</dt>
              <dd>{project.data.client}</dd>
            </div>
          )
        }
        {
          timeline && (
            <div>
              <dt class="trace-annotation">Timeline</dt>
              <dd>{timeline}</dd>
            </div>
          )
        }
        {
          project.data.technologies.length > 0 && (
            <div>
              <dt class="trace-annotation">Technology</dt>
              <dd>{project.data.technologies.join(" · ")}</dd>
            </div>
          )
        }
        {
          project.data.links?.website && (
            <div>
              <dt class="trace-annotation">Live</dt>
              <dd>
                <a
                  class="meta-link"
                  href={project.data.links.website}
                  target="_blank"
                  rel="noreferrer"
                >
                  Visit product <span aria-hidden="true">↗</span>
                </a>
              </dd>
            </div>
          )
        }
      </dl>

      <div class="project-body">
        {
          project.data.responsibilities && (
            <section class="case-block">
              <h2 class="annotation">Contribution</h2>
              <ul>
                {project.data.responsibilities.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="prose prose-lg case-prose">
          <Content />
        </div>

        {
          project.data.outcomes && (
            <section class="case-block outcomes">
              <h2 class="annotation">Outcomes</h2>
              <ul>
                {project.data.outcomes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-block: 2.5rem 7rem;
  }

  .project-header {
    margin-top: 2.5rem;
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 8vw, 6rem);
    line-height: 0.9;
    overflow-wrap: anywhere;
  }

  .project-subtitle {
    margin-top: 1.25rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-summary {
    max-width: 58ch;
    margin-top: 1.75rem;
    color: var(--body);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .meta-band {
    display: grid;
    margin: 3rem 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .meta-band > div {
    border-bottom: 1px solid var(--line);
    padding: 1rem 1.25rem;
  }

  .meta-band > div:last-child {
    border-bottom: 0;
  }

  .meta-band dd {
    margin: 0.5rem 0 0;
    color: var(--body);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .meta-link {
    color: var(--accent);
    font-weight: 700;
    transition: color 160ms var(--ease-out);
  }

  .meta-link:hover {
    color: var(--ink);
  }

  .project-body {
    max-width: 48rem;
    padding-top: 3.5rem;
  }

  .case-block h2 {
    color: var(--accent);
  }

  .case-block ul {
    display: grid;
    gap: 0.85rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .case-block li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--body);
    line-height: 1.65;
  }

  .case-block li::before {
    position: absolute;
    top: 0.5rem;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid var(--accent);
    content: "";
  }

  .case-prose {
    max-width: 65ch;
    margin-top: 3rem;
  }

  .case-prose :global(h2) {
    margin-top: 2.75rem;
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .outcomes {
    margin-top: 3.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.5rem;
  }

  .outcomes li::before {
    background: var(--accent);
  }

  @media (min-width: 48rem) {
    .project-page {
      padding-block: 3.5rem 10rem;
    }

    .project-header {
      margin-top: 3.5rem;
    }

    .meta-band {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      margin-top: 4rem;
    }

    .meta-band > div {
      border-right: 1px solid var(--line);
      border-bottom: 0;
      padding: 1.25rem 1.5rem;
    }

    .meta-band > div:last-child {
      border-right: 0;
    }

    .project-body {
      padding-top: 4.5rem;
    }
  }
</style>
