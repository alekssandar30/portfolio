---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes")).filter(
  (note) => note.data.published,
);
---

<BaseLayout
  title="Notes"
  description="Technical notes on full-stack engineering, .NET, TypeScript and AI-native software workflows."
  pathname="/notes"
>
  <section class="page-section">
    <div class="container-shell">
      <header class="page-head">
        <div class="head-rule">
          <p class="annotation">Notes</p>
          <p class="annotation head-meta">
            {String(notes.length).padStart(2, "0")} published
          </p>
        </div>
        <h1 class="display-heading">
          Notes on software systems and engineering workflow.
        </h1>
        <p class="page-lede">
          TypeScript, .NET, architecture, modernization and AI-native software
          delivery.
        </p>
      </header>
      <div class="notes-list">
        {
          notes.map((note, index) => (
            <a class="note-row" href={`/notes/${note.slug}`}>
              <span class="note-index">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="note-main">
                <span class="annotation note-topic">
                  {note.data.topics[0] ?? "Engineering"}
                </span>
                <h2>{note.data.title}</h2>
                <span class="note-description">{note.data.description}</span>
              </span>
              <span class="note-arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    min-height: 70vh;
    padding-block: 4rem 8rem;
  }

  .page-head {
    margin-bottom: 3rem;
  }

  .head-rule {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .head-meta {
    color: var(--faint);
  }

  h1 {
    max-width: 20ch;
    margin-top: 1.5rem;
    font-size: clamp(2rem, 5.4vw, 3.75rem);
  }

  .page-lede {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .note-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 2rem;
    gap: 1rem;
    align-items: start;
    padding: 2rem 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .note-row:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .note-index {
    padding-top: 0.35rem;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .note-topic {
    color: var(--accent);
  }

  h2 {
    max-width: 28ch;
    margin-top: 0.75rem;
    font-size: clamp(1.375rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    transition: color 160ms var(--ease-out);
  }

  .note-description {
    display: block;
    max-width: 60ch;
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .note-arrow {
    justify-self: end;
    padding-top: 0.35rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.125rem;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 180ms var(--ease-out),
      transform 180ms var(--ease-out);
  }

  .note-row:hover h2,
  .note-row:focus-visible h2 {
    color: var(--accent);
  }

  .note-row:hover .note-arrow,
  .note-row:focus-visible .note-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (min-width: 48rem) {
    .page-section {
      padding-block: 6rem 12rem;
    }

    .page-head {
      margin-bottom: 4.5rem;
    }

    .note-row {
      grid-template-columns: 3.5rem minmax(0, 1fr) 2.5rem;
      gap: 1.5rem;
      padding: 2.5rem 1.25rem;
    }
  }
</style>
