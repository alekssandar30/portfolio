---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { articleSchema } from "@/lib/schema";
import { siteConfig } from "@/lib/site";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const notes = (await getCollection("notes")).filter(
    (note) => note.data.published,
  );
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<"notes">;
}

const { note } = Astro.props;
const { Content } = await note.render();
const siteUrl = Astro.site?.toString() ?? siteConfig.url;
---

<BaseLayout
  title={note.data.title}
  description={note.data.description}
  jsonLd={articleSchema(
    siteUrl,
    `/notes/${note.slug}`,
    note.data.title,
    note.data.description,
    note.data.pubDate,
  )}
>
  <article class="note-page">
    <div class="note-shell">
      <a class="back-link" href="/notes">← Notes</a>
      <header>
        <p class="annotation note-topics">{note.data.topics.join(" · ")}</p>
        <h1>{note.data.title}</h1>
        <p class="note-description">{note.data.description}</p>
      </header>
      <div class="prose prose-lg">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .note-page {
    padding-block: 2.5rem 7rem;
  }

  .note-shell {
    width: min(calc(100% - 2rem), 48rem);
    margin-inline: auto;
  }

  header {
    margin-top: 2.5rem;
  }

  .note-topics {
    color: var(--accent);
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2rem, 5.4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.02;
  }

  .note-description {
    max-width: 60ch;
    margin-top: 1.5rem;
    color: var(--body);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .prose {
    max-width: 65ch;
    margin-top: 3rem;
  }

  @media (min-width: 48rem) {
    .note-page {
      padding-block: 3.5rem 10rem;
    }

    .note-shell {
      width: min(calc(100% - 4rem), 48rem);
    }

    header {
      margin-top: 4rem;
    }

    .prose {
      margin-top: 4rem;
    }
  }
</style>
