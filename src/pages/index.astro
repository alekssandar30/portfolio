---
import EditorialProject from "@/components/EditorialProject.astro";
import EngineeringSystem from "@/components/EngineeringSystem.astro";
import ExperienceTimeline from "@/components/ExperienceTimeline.astro";
import FeaturedProject from "@/components/FeaturedProject.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import TechStack from "@/components/TechStack.astro";
import { person } from "@/data/person";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { personSchema, professionalServiceSchema } from "@/lib/schema";
import { siteConfig } from "@/lib/site";
import { getCollection } from "astro:content";

const projectOrder = ["linetracker", "ehzzo", "nct", "swap-fm"];
const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => projectOrder.indexOf(a.slug) - projectOrder.indexOf(b.slug));
const [featuredProject, ...otherProjects] = projects;
const siteUrl = Astro.site?.toString() ?? siteConfig.url;
---

<BaseLayout
  jsonLd={[personSchema(siteUrl), professionalServiceSchema(siteUrl)]}
>
  <section class="intro">
    <div class="container-shell">
      <p class="hero-context">
        <span aria-hidden="true">·</span> Novi
        Sad, Serbia
      </p>
      <h1>Aleksandar <span>Novakovic.</span></h1>
      <div class="hero-copy">
        <p class="hero-description">
          I build production software across frontend and backend, specializing
          in TypeScript and C#/.NET for enterprise applications, platforms and
          digital products.
        </p>
        <div class="hero-actions">
          <a href="/work" class="action action-primary">Explore my work</a>
          <a href="/contact" class="action action-secondary">Work with me</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad" id="selected-work">
    <div class="container-shell">
      <SectionIntro
        eyebrow="Selected work"
        title="Production systems in complex domains."
        text="A selection of public and responsibly anonymized engineering work across industrial software, banking, healthcare and product teams."
      />
      {featuredProject && <FeaturedProject project={featuredProject} index={0} />}
      <div>
        {
          otherProjects.map((project, index) => (
            <EditorialProject project={project} index={index + 1} />
          ))
        }
      </div>
      <a class="text-link section-link" href="/work">
        View all work <span class="link-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section-pad surface-band" id="engineering-system">
    <div class="container-shell">
      <SectionIntro
        eyebrow="Capabilities"
        title="Engineering across the product stack."
        text="The useful work often happens between layers: application behavior, APIs, data, permissions and production constraints shape one another."
      />
      <EngineeringSystem />
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell split-layout">
      <SectionIntro
        eyebrow="Experience"
        title="Different domains, serious constraints."
        text="More than seven years working in existing production systems where reliability, domain understanding and careful delivery matter."
      />
      <ExperienceTimeline />
    </div>
  </section>

  <section class="section-pad surface-band">
    <div class="container-shell split-layout">
      <SectionIntro
        eyebrow="Technology"
        title="A production stack centered on TypeScript and C#/.NET."
        text="Frameworks are tools inside broader systems of application behavior, APIs, data and long-term maintenance."
      />
      <TechStack />
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell about-layout">
      <div class="about-portrait">
        <img
          src="/aleksandar-novakovic.png"
          alt="Aleksandar Novakovic"
          width="256"
          height="256"
          loading="lazy"
        />
      </div>
      <div class="about-copy">
        <p class="eyebrow">About</p>
        <h2>Independent engineering through {person.company}.</h2>
        <p>
          I am a full-stack software engineer from Novi Sad, working with
          companies as an independent B2B contractor. I join existing product
          and engineering teams for project-based and longer-term engagements.
        </p>
        <div class="about-links">
          <a class="text-link" href="/about">
            More about me <span class="link-arrow" aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="/contact">
            Contact <span class="link-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-band">
    <div class="container-shell contact-layout">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Available for B2B software engineering engagements.</h2>
      </div>
      <a href="/contact" class="action action-primary">Start a conversation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: 4rem 4.5rem;
  }

  .hero-context {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .hero-context span {
    margin-inline: 0.35rem;
    color: var(--signal);
  }

  h1 {
    margin-top: 2rem;
    font-size: 3rem;
    font-weight: 620;
    letter-spacing: 0;
    line-height: 0.95;
  }

  h1 span {
    color: var(--signal);
  }

  .hero-copy {
    max-width: 42rem;
    margin-top: 2rem;
  }

  .hero-description {
    max-width: 58ch;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .hero-actions,
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .section-link {
    margin-top: 2rem;
  }

  .about-layout {
    display: grid;
    gap: 2.5rem;
  }

  .about-portrait {
    width: 8rem;
  }

  .about-copy {
    max-width: 43rem;
  }

  .about-copy h2,
  .contact-layout h2 {
    margin-top: 0.75rem;
    font-size: 2rem;
    font-weight: 620;
    letter-spacing: 0;
    line-height: 1.08;
  }

  .about-copy > p:not(.eyebrow) {
    max-width: 60ch;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .about-links {
    gap: 1.5rem;
  }

  .contact-band {
    background: var(--surface);
    padding-block: 5rem;
  }

  .contact-layout {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .contact-layout h2 {
    max-width: 18ch;
  }

  .contact-layout .action {
    width: fit-content;
  }

  @media (min-width: 48rem) {
    .intro {
      padding-block: 5rem 4.5rem;
    }

    h1 {
      margin-top: 2.25rem;
      font-size: 4rem;
    }

    .hero-copy {
      margin-top: 2.25rem;
    }

    .hero-description {
      font-size: 1.125rem;
    }

    .split-layout {
      display: grid;
      grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
      gap: 5rem;
      align-items: start;
    }

    .split-layout :global(.section-intro) {
      position: sticky;
      top: 2rem;
      margin-bottom: 0;
    }

    .about-layout {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 5rem;
      align-items: start;
    }

    .about-portrait {
      width: 10rem;
    }

    .about-copy h2,
    .contact-layout h2 {
      font-size: 2.5rem;
    }

    .contact-layout {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4rem;
    }
  }

  @media (min-width: 64rem) {
    h1 {
      font-size: 4.5rem;
    }
  }
</style>
